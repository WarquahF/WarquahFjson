---
import '../styles/global.css';
import { sections } from '../data/nav';
import Loader from '../components/svelte/Loader.svelte';
import CommandPalette from '../components/svelte/CommandPalette.svelte';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Warquah Faiz — Student Developer',
  description = 'Warquah Faiz — student developer exploring how software works. Building software, studying systems, documenting what I learn.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f5f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
      </>
    )}
  </head>
  <body>
    <Loader client:load />

    <div class="gutter-shell" id="home">
      <aside class="gutter" aria-label="Section index">
        <span class="mono gutter-side-label">W</span>
        <div class="gutter-line">
          <div class="gutter-ticks" id="gutter-ticks">
            {sections.slice(1).filter((s) => s.href.startsWith('#')).map((s) => (
              <div class="gutter-tick" data-target={s.href}>
                <div class="gutter-mark"></div>
              </div>
            ))}
          </div>
        </div>
        <span class="mono gutter-side-label">2026</span>
      </aside>

      <main>
        <slot />
      </main>
    </div>

    <CommandPalette client:idle />

    <script>
      const ticks = Array.from(document.querySelectorAll<HTMLElement>('.gutter-tick'));
      const targets = ticks
        .map((tick) => {
          const id = tick.dataset.target?.replace('#', '');
          const el = id ? document.getElementById(id) : null;
          return el ? { tick, el } : null;
        })
        .filter((v): v is { tick: HTMLElement; el: HTMLElement } => v !== null);

      if (targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const match = targets.find((t) => t.el === entry.target);
              if (!match) return;
              match.tick.dataset.active = entry.isIntersecting ? 'true' : 'false';
            });
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
        );
        targets.forEach((t) => observer.observe(t.el));
      }

      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      revealEls.forEach((el) => revealObserver.observe(el));

      const textRevealEls = document.querySelectorAll<HTMLElement>('[data-text-reveal]');
      textRevealEls.forEach((el, elIndex) => {
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        el.innerHTML = words
          .map((w, i) => `<span class="word" style="transition-delay:${i * 25}ms">${w}</span>`)
          .join(' ');
        el.setAttribute('aria-label', words.join(' '));
        if (elIndex === 0) el.setAttribute('role', 'text');
      });

      const textRevealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              textRevealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.35 }
      );
      textRevealEls.forEach((el) => textRevealObserver.observe(el));

      // Cinematic entrance: split into masked words, stagger in on view.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLElement>('[data-entrance]').forEach((el) => {
        if (reduceMotion) {
          el.classList.add('is-in');
          return;
        }
        const delay = Number(el.dataset.entranceDelay ?? 0);
        const step = Number(el.dataset.entranceStep ?? 55);
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.innerHTML = words
          .map((w, i) => `<span class="w"><span style="transition-delay:${delay + i * step}ms">${w}</span></span>`)
          .join(' ');
        el.setAttribute('aria-label', label);
      });
      const entranceObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              entranceObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      document.querySelectorAll('[data-entrance],[data-fade-late],[data-scale-in]').forEach((el) =>
        entranceObserver.observe(el)
      );

      // Scroll-highlight storytelling: light words as they cross mid-viewport.
      const highlightEls = Array.from(document.querySelectorAll<HTMLElement>('[data-highlight]'));
      highlightEls.forEach((el) => {
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.innerHTML = words.map((w) => `<span class="hw">${w}</span>`).join(' ');
        el.setAttribute('aria-label', label);
      });
      const paintHighlights = () => {
        const vh = window.innerHeight;
        highlightEls.forEach((el) => {
          const words = Array.from(el.querySelectorAll('.hw'));
          if (!words.length) return;
          // Pinned stages: drive progress from the tall section's travel,
          // so words light while the statement holds still.
          const section = el.closest('section');
          const sectionRect = section?.getBoundingClientRect();
          let progress: number;
          if (sectionRect && sectionRect.height > vh * 1.2) {
            const travel = sectionRect.height - vh;
            progress = Math.min(1, Math.max(0, -sectionRect.top / travel));
            // Ease the ends: first word lights shortly after pin, last
            // word completes just before release.
            progress = Math.min(1, Math.max(0, (progress - 0.08) / 0.84));
          } else {
            const rect = el.getBoundingClientRect();
            progress = Math.min(1, Math.max(0, (vh * 0.82 - rect.top) / (rect.height + vh * 0.3)));
          }
          const lit = Math.floor(progress * (words.length + 1));
          words.forEach((w, i) => w.classList.toggle('lit', reduceMotion || i < lit));
        });
      };
      let highlightTick = false;
      const onScrollPaint = () => {
        if (highlightTick) return;
        highlightTick = true;
        requestAnimationFrame(() => {
          paintHighlights();
          highlightTick = false;
        });
      };
      window.addEventListener('scroll', onScrollPaint, { passive: true });
      window.addEventListener('resize', onScrollPaint);
      paintHighlights();

      // Gentle parallax drift (transform-only, rAF-throttled).
      const driftEls = Array.from(document.querySelectorAll<HTMLElement>('[data-drift]'));
      const paintDrift = () => {
        if (reduceMotion || !driftEls.length) return;
        const vh = window.innerHeight;
        driftEls.forEach((el) => {
          const speed = Number(el.dataset.drift ?? 0.06);
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height / 2 - vh / 2;
          el.style.transform = `translate3d(0, ${(-center * speed).toFixed(1)}px, 0)`;
        });
      };
      let driftTick = false;
      window.addEventListener(
        'scroll',
        () => {
          if (driftTick) return;
          driftTick = true;
          requestAnimationFrame(() => {
            paintDrift();
            driftTick = false;
          });
        },
        { passive: true }
      );
      paintDrift();

      // Viewport-triggered phrase highlighting: author phrases with
      // `|` separators; each phrase lights fully when it crosses the
      // trigger band (~middle viewport) and stays lit. Discrete events.
      document.querySelectorAll<HTMLElement>('[data-trigger-highlight]').forEach((el) => {
        const full = el.textContent ?? '';
        el.setAttribute('aria-label', full.split('|').join(' ').replace(/\s+/g, ' ').trim());
        el.innerHTML = full
          .split('|')
          .map((part) => part.trim())
          .filter(Boolean)
          .map(
            (phrase) =>
              `<span class="tph">${phrase
                .split(/\s+/)
                .map((w) => `<span class="tw">${w}</span>`)
                .join(' ')}</span>`
          )
          .join(' ');
        if (reduceMotion) {
          el.querySelectorAll('.tph').forEach((p) => p.classList.add('lit'));
          return;
        }
        const triggerObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('lit');
                triggerObserver.unobserve(entry.target);
              }
            });
          },
          // Trigger band centered ~50% viewport height.
          { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
        );
        el.querySelectorAll('.tph').forEach((p) => triggerObserver.observe(p));
      });

      // Nav: transparent at top, solid once scrolling.
      const nav = document.querySelector('.nav');
      const paintNav = () => nav?.classList.toggle('is-solid', window.scrollY > 24);
      window.addEventListener('scroll', paintNav, { passive: true });
      paintNav();
    </script>

    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.5s var(--ease, ease), transform 0.5s var(--ease, ease);
      }
      [data-reveal].is-revealed {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
