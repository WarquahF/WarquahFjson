---
import '../styles/global.css';
import { sections } from '../data/nav';
import CommandPalette from '../components/svelte/CommandPalette.svelte';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Warquah Faiz — Student Developer',
  description = 'Warquah Faiz — student developer exploring how software works. Building software, studying systems, documenting what I learn.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0d0d10" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('wf-theme') || 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
      </>
    )}
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="gutter-shell" id="home">
      <aside class="gutter" aria-label="Section index">
        <span class="mono gutter-side-label">W</span>
        <div class="gutter-line">
          <div class="gutter-ticks" id="gutter-ticks">
            {sections.slice(1).filter((s) => s.href.startsWith('#')).map((s) => (
              <div class="gutter-tick" data-target={s.href}>
                <div class="gutter-mark"></div>
              </div>
            ))}
          </div>
        </div>
        <span class="mono gutter-side-label">2026</span>
      </aside>

      <main>
        <slot />
      </main>
    </div>

    <CommandPalette client:idle />

    <script>
      import { animate, inView, scroll, stagger } from 'motion';

      // Motion engine: one calm language — transform + opacity only,
      // hardware-accelerated at 60fps. Discrete class flips remain solely
      // for scroll-scrubbed word lighting.
      const EASE: [number, number, number, number] = [0.22, 1, 0.36, 1];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const ticks = Array.from(document.querySelectorAll<HTMLElement>('.gutter-tick'));
      const targets = ticks
        .map((tick) => {
          const id = tick.dataset.target?.replace('#', '');
          const el = id ? document.getElementById(id) : null;
          return el ? { tick, el } : null;
        })
        .filter((v): v is { tick: HTMLElement; el: HTMLElement } => v !== null);

      if (targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const match = targets.find((t) => t.el === entry.target);
              if (!match) return;
              match.tick.dataset.active = entry.isIntersecting ? 'true' : 'false';
            });
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
        );
        targets.forEach((t) => observer.observe(t.el));
      }

      // Word-mask prep for display entrances (one-time DOM work; Motion
      // drives the animation, CSS only holds the pre-state + end state).
      document.querySelectorAll<HTMLElement>('[data-entrance]').forEach((el) => {
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.innerHTML = words
          .map((w) => `<span class="w"><span>${w}</span></span>`)
          .join(' ');
        el.setAttribute('aria-label', label);
        if (reduceMotion) el.classList.add('is-in');
      });

      if (!reduceMotion) {
        // Hero intro timeline: page rises, headline staggers in word by word.
        if (document.querySelector('.hero')) {
          animate('.hero[data-reveal]', { opacity: [0, 1], y: [18, 0] }, { duration: 0.9, ease: EASE });
        }
        const heroWords = document.querySelectorAll('.hero [data-entrance] .w > span');
        if (heroWords.length) {
          animate(
            heroWords,
            { y: ['110%', '0%'], opacity: [0, 1] },
            { duration: 1, ease: EASE, delay: stagger(0.06, { startDelay: 0.2 }) }
          );
        }
        const heroFades = document.querySelectorAll('.hero [data-fade-late]');
        if (heroFades.length) {
          animate(
            heroFades,
            { opacity: [0, 1], y: [14, 0] },
            { duration: 0.8, ease: EASE, delay: stagger(0.09, { startDelay: 0.5 }) }
          );
        }

        // Calm scroll reveals: everything below the hero fades up once.
        // Initial states are set in JS so no-JS visitors still see content.
        const batch = Array.from(
          document.querySelectorAll<HTMLElement>(
            '[data-reveal], [data-fade-late], [data-scale-in], [data-text-reveal]'
          )
        ).filter((el) => !el.closest('.hero'));
        batch.forEach((el) => {
          if (el.hasAttribute('data-scale-in')) {
            animate(el, { opacity: 0, scale: 0.97 }, { duration: 0 });
          } else {
            animate(el, { opacity: 0, y: 16 }, { duration: 0 });
          }
        });
        if (batch.length) {
          inView(
            batch,
            (el) => {
              if ((el as HTMLElement).hasAttribute('data-scale-in')) {
                animate(el, { opacity: 1, scale: 1 }, { duration: 0.9, ease: EASE });
              } else {
                animate(el, { opacity: 1, y: 0 }, { duration: 0.8, ease: EASE });
              }
            },
            { amount: 0.2, margin: '0px 0px -6% 0px' }
          );
        }

        // Display entrances below the fold stagger in on first view.
        document.querySelectorAll<HTMLElement>('[data-entrance]').forEach((el) => {
          if (el.closest('.hero')) return;
          const words = el.querySelectorAll('.w > span');
          if (!words.length) return;
          const step = Number(el.dataset.entranceStep ?? 55) / 1000;
          inView(
            el,
            () => {
              animate(
                words,
                { y: ['110%', '0%'], opacity: [0, 1] },
                { duration: 0.9, ease: EASE, delay: stagger(step) }
              );
            },
            { amount: 0.4 }
          );
        });
      }

      // Scroll progress hairline: bound straight to page scroll.
      const progress = document.querySelector('.progress');
      if (progress) {
        scroll(animate(progress, { scaleX: [0, 1] }, { ease: 'linear' }));
      }

      if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
        // Magnetic primary buttons: drift toward the cursor, spring home.
        document.querySelectorAll<HTMLElement>('.btn-primary').forEach((btn) => {
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            animate(
              btn,
              {
                x: (e.clientX - r.left - r.width / 2) * 0.14,
                y: (e.clientY - r.top - r.height / 2) * 0.22,
              },
              { duration: 0.25, ease: 'easeOut' }
            );
          });
          btn.addEventListener('pointerleave', () => {
            animate(btn, { x: 0, y: 0 }, { type: 'spring', stiffness: 320, damping: 20 });
          });
        });
      }

      // Word-split prep for scroll-scrubbed statements (one-time DOM work).
      document.querySelectorAll<HTMLElement>('[data-highlight]').forEach((el) => {
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.innerHTML = words.map((w) => `<span class="hw">${w}</span>`).join(' ');
        el.setAttribute('aria-label', label);
      });

      if (reduceMotion) {
        document.querySelectorAll('[data-highlight] .hw').forEach((w) => w.classList.add('lit'));
      } else {
        // Pinned statement moments: the section holds still (sticky CSS)
        // while Motion binds word emphasis to scroll progress — no scroll
        // listeners, ScrollTimeline-accelerated where supported.
        document.querySelectorAll<HTMLElement>('[data-highlight]').forEach((el) => {
          const words = Array.from(el.querySelectorAll('.hw'));
          if (!words.length) return;
          const section = el.closest('section') ?? el;
          let lit = -1;
          const paint = (progress: number) => {
            // Ease the ends: first word lights shortly after pin, last
            // word completes just before release.
            const eased = Math.min(1, Math.max(0, (progress - 0.08) / 0.84));
            const count = Math.floor(eased * (words.length + 1));
            if (count === lit) return;
            lit = count;
            words.forEach((w, i) => w.classList.toggle('lit', i < count));
          };
          paint(0);
          scroll((progress) => paint(typeof progress === 'number' ? progress : 0), {
            target: section,
            offset: ['start start', 'end end'],
          });
        });

        // Gentle parallax drift (transform-only, scroll-bound).
        document.querySelectorAll<HTMLElement>('[data-drift]').forEach((el) => {
          const speed = Number(el.dataset.drift ?? 0.06);
          const amp = Math.min(48, speed * 500);
          scroll(animate(el, { y: [amp, -amp] }, { ease: 'linear' }), {
            target: el.closest('section') ?? el,
            offset: ['start end', 'end start'],
          });
        });
      }

      // Viewport-triggered phrase highlighting: author phrases with
      // `|` separators; each phrase lights fully when it enters view
      // and stays lit. Discrete events.
      document.querySelectorAll<HTMLElement>('[data-trigger-highlight]').forEach((el) => {
        const full = el.textContent ?? '';
        el.setAttribute('aria-label', full.split('|').join(' ').replace(/\s+/g, ' ').trim());
        el.innerHTML = full
          .split('|')
          .map((part) => part.trim())
          .filter(Boolean)
          .map(
            (phrase) =>
              `<span class="tph">${phrase
                .split(/\s+/)
                .map((w) => `<span class="tw">${w}</span>`)
                .join(' ')}</span>`
          )
          .join(' ');
      });

      if (reduceMotion) {
        document.querySelectorAll('[data-trigger-highlight] .tph').forEach((p) => p.classList.add('lit'));
      } else {
        document.querySelectorAll('.tph').forEach((p) => {
          inView(p, () => p.classList.add('lit'), { amount: 0.6 });
        });
      }

      // Nav: transparent at top, solid once scrolling.
      const nav = document.querySelector('.nav');
      const paintNav = () => nav?.classList.toggle('is-solid', window.scrollY > 24);
      window.addEventListener('scroll', paintNav, { passive: true });
      paintNav();
    </script>

    <style is:global>
      /* Reveal + entrance states are driven by Motion (see script above).
         No CSS-hidden defaults: no-JS visitors still see full content. */
    </style>
  </body>
</html>
