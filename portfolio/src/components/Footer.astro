---
import { social } from '../data/nav';
const year = new Date().getFullYear();
const homeHref = Astro.url.pathname === '/' ? '#home' : '/#home';
---

<footer class="footer mono">
  <p>Warquah Faiz © {year} — Designed and built by Warquah Faiz.</p>
  <div class="footer-links">
    <a href={social.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={social.x} target="_blank" rel="noreferrer">X</a>
    <a href={`mailto:${social.email}`}>Email</a>
    <a href={homeHref}>Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-lg) clamp(1.25rem, 5vw, 3.5rem) var(--space-2xl);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--signal);
  }
</style>
