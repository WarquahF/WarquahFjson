---
import { projects, archive } from '../data/projects';
---

<section class="section" id="projects" data-reveal>
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/projects</span></p>
    <h2 data-text-reveal>Selected work</h2>
    <p style="margin-top: 0.5rem;">Featured work and everything in between. Open a record for detail.</p>

    <div class="records">
      {projects.map((p) => (
        <article class="record" data-project={p.slug} tabindex="0" role="button" aria-haspopup="dialog">
          <div class="record-visual">
            <div class="record-mark" data-project-mark={p.slug}></div>
          </div>
          <div class="record-content">
            {p.featured && <span class="record-flag mono">Featured</span>}
            <div class="record-head">
              <h3>{p.name}</h3>
              <span class="mono record-kind">{p.kind}</span>
            </div>
            <p class="record-summary">{p.summary}</p>
            <div class="record-stack mono">
              {p.stack.map((s) => <span>{s}</span>)}
            </div>
            <span class="record-open mono">Open record <span class="record-arrow">→</span></span>
          </div>
        </article>
      ))}
    </div>

    <div class="archive">
      <p class="eyebrow" style="margin-bottom: 0.5rem;"><span class="path">/archive</span></p>
      <ul class="archive-list mono">
        {archive.map((a, i) => (
          <li><span class="archive-index">{String(i + 1).padStart(2, '0')}</span>{a.name}<span class="archive-note">{a.note}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-project]');
  cards.forEach((card) => {
    const open = () => {
      window.dispatchEvent(new CustomEvent('open-project', { detail: card.dataset.project }));
    };
    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  });
</script>

<style>
  .records {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .record {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-lg);
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    transition: background 0.2s var(--ease-out);
  }

  .record:hover,
  .record:focus-visible {
    background: color-mix(in srgb, var(--bg-raised) 40%, transparent);
  }

  @media (max-width: 640px) {
    .record {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .record-visual {
    display: flex;
    align-items: flex-start;
    padding-top: 0.15rem;
  }

  .record-mark {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    position: relative;
    transition: border-color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }

  .record:hover .record-mark,
  .record:focus-visible .record-mark {
    border-color: var(--signal);
    transform: scale(1.05);
  }

  /* Blink mark — a small abstract eye/signal shape */
  [data-project-mark='blink']::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-ghost), 0 0 12px 2px var(--signal-ghost);
  }

  /* Nugget mark — a small diamond/mineral shape */
  [data-project-mark='nugget']::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--signal);
  }

  .record-content {
    min-width: 0;
  }

  .record-flag {
    display: inline-block;
    font-size: var(--step--2);
    color: var(--signal);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-xs);
  }

  .record-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .record-kind {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .record-summary {
    margin-top: var(--space-xs);
    max-width: 50ch;
    font-size: var(--step-0);
    color: var(--ink-dim);
    line-height: 1.55;
  }

  .record-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-sm);
  }

  .record-stack span {
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .record:hover .record-stack span {
    border-color: var(--line-strong);
    color: var(--ink-dim);
  }

  .record-open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-md);
    font-size: var(--step--1);
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
  }

  .record-arrow {
    transition: transform 0.25s var(--ease-out);
    display: inline-block;
  }

  .record:hover .record-open,
  .record:focus-visible .record-open {
    color: var(--signal);
  }

  .record:hover .record-arrow,
  .record:focus-visible .record-arrow {
    transform: translateX(3px);
  }

  .archive {
    margin-top: var(--space-2xl);
  }

  .archive-list {
    border-top: 1px solid var(--line);
  }

  .archive-list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .archive-index {
    color: var(--ink-faint);
  }

  .archive-note {
    margin-left: auto;
    color: var(--ink-faint);
  }
</style>
