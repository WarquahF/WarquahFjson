---
import { projects, archive } from '../data/projects';
---

<section class="section work" id="work" data-reveal>
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/work</span></p>
    <h2 class="work-title" data-entrance>Two products. One philosophy.</h2>
    <p class="work-lede" data-fade-late>Desktop software, presented like products — because that's how they're built.</p>

    <div class="stories">
      {projects.map((p, i) => (
        <article class="story" data-project={p.slug} tabindex="0" role="button" aria-haspopup="dialog" data-reveal>
          <div class="story-meta mono">
            <span>{String(i + 1).padStart(2, '0')}</span>
            {p.featured && <span class="story-flag">Featured</span>}
            <span class="story-kind">{p.kind}</span>
          </div>
          <div class="story-grid">
            <div class="story-copy">
              <h3 class="story-name" data-drift="0.02">{p.name}</h3>
              <p class="story-summary">{p.summary}</p>
              <p class="story-detail">{p.detail}</p>
              <div class="story-stack mono">
                {p.stack.map((s) => <span>{s}</span>)}
              </div>
              <span class="record-open mono">Open record <span class="link-arrow">→</span></span>
            </div>
            <div class="story-visual" data-scale-in>
              <div class="visual-frame" data-visual={p.slug}>
                <span class="visual-glyph"></span>
                {p.flow && (
                  <div class="visual-flow mono">
                    {p.flow.map((row) => (
                      <span class="vf-row">
                        {row.map((step) => <span class="vf-node">{step.label}</span>)}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="archive">
      <p class="eyebrow" style="margin-bottom: 0.5rem;"><span class="path">/archive</span></p>
      <ul class="archive-list mono">
        {archive.map((a, i) => (
          <li><span class="archive-index">{String(i + 1).padStart(2, '0')}</span>{a.name}<span class="archive-note">{a.note}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-project]');
  cards.forEach((card) => {
    const open = () => {
      window.dispatchEvent(new CustomEvent('open-project', { detail: card.dataset.project }));
    };
    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  });
</script>

<style>
  .work-title {
    max-width: 16ch;
  }

  .work-lede {
    margin-top: var(--space-xs);
  }

  .stories {
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
  }

  .story {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-top: 1px solid var(--line);
    cursor: pointer;
  }

  .story:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .story-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-lg);
  }

  .story-flag {
    color: var(--signal);
  }

  .story-kind {
    margin-left: auto;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  /* Alternate: even stories mirror the composition */
  .story:nth-of-type(even) .story-copy {
    order: 2;
  }
  .story:nth-of-type(even) .story-visual {
    order: 1;
  }

  @media (max-width: 820px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story:nth-of-type(even) .story-copy,
    .story:nth-of-type(even) .story-visual {
      order: initial;
    }
  }

  .story-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0;
  }

  .story-summary {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 36ch;
    line-height: 1.45;
  }

  .story-detail {
    margin-top: var(--space-sm);
    font-size: var(--step-0);
    max-width: 52ch;
    line-height: 1.6;
  }

  .story-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-md);
  }

  .story-stack span {
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .story:hover .story-stack span {
    border-color: var(--line-strong);
    color: var(--ink-dim);
  }

  .record-open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-lg);
    font-size: var(--step--1);
    color: var(--ink-faint);
    transition: color 0.2s ease;
  }

  .story:hover .record-open {
    color: var(--signal);
  }

  /* Visual: quiet product frame, no gradients, no glow */
  .visual-frame {
    position: relative;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.5s var(--cinematic, ease), border-color 0.3s ease;
  }

  .story:hover .visual-frame {
    transform: scale(1.01);
    border-color: var(--line-strong);
  }

  .visual-glyph {
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    position: relative;
  }

  [data-visual='blink'] .visual-glyph::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--signal);
  }

  [data-visual='nugget'] .visual-glyph::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--signal);
  }

  .visual-flow {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  .vf-row {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .vf-node {
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.15rem 0.45rem;
  }

  .archive {
    margin-top: var(--space-2xl);
  }

  .archive-list {
    border-top: 1px solid var(--line);
  }

  .archive-list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .archive-index {
    color: var(--ink-faint);
  }

  .archive-note {
    margin-left: auto;
    color: var(--ink-faint);
  }
</style>
