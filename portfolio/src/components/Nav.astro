---
import { sections, social } from '../data/nav';

const isHome = Astro.url.pathname === '/';
const linkFor = (href: string) =>
  !isHome && href.startsWith('#') ? `/${href}` : href;
---

<header class="nav glass">
  <a class="nav-mark mono" href={linkFor('#home')} aria-label="Home">
    <span class="nav-mark-box">W</span>
    <span class="nav-mark-name">WARQUAH FAIZ</span>
  </a>

  <nav class="nav-links mono" aria-label="Primary">
    {sections.slice(1).map((s) => (
      <a href={linkFor(s.href)}>{s.label}</a>
    ))}
  </nav>

  <div class="nav-right">
    <a class="nav-github mono" href={social.github} target="_blank" rel="noreferrer">
      github.com/WarquahF
    </a>
    <button class="nav-kbd mono" type="button" data-command-trigger aria-label="Open command palette">
      <span>⌘</span>K
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1.25rem, 5vw, 3.5rem);
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    box-shadow: none;
  }

  .nav-mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    transition: opacity 0.2s var(--ease-out);
  }

  .nav-mark:hover {
    opacity: 0.8;
  }

  .nav-mark-box {
    width: 1.4rem;
    height: 1.4rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--signal);
    font-size: 0.7rem;
  }

  .nav-mark-name {
    display: none;
  }

  @media (min-width: 560px) {
    .nav-mark-name {
      display: inline;
    }
  }

  .nav-links {
    display: none;
    gap: 1.25rem;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--signal);
    transition: width 0.25s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  @media (min-width: 780px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-github {
    display: none;
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .nav-github:hover {
    color: var(--ink);
  }

  @media (min-width: 960px) {
    .nav-github {
      display: inline;
    }
  }

  .nav-kbd {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-kbd:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
</style>
