---
import { sections, social } from '../data/nav';

const isHome = Astro.url.pathname === '/';
const linkFor = (href: string) =>
  !isHome && href.startsWith('#') ? `/${href}` : href;
---

<header class="nav">
  <a class="nav-mark mono" href={linkFor('#home')} aria-label="Home">
    <span class="nav-mark-box">W</span>
    <span class="nav-mark-name">WARQUAH FAIZ</span>
  </a>

  <nav class="nav-links mono" aria-label="Primary">
    {sections.slice(1).map((s) => (
      <a href={linkFor(s.href)}>{s.label}</a>
    ))}
  </nav>

  <div class="nav-right">
    <a class="nav-github mono" href={social.github} target="_blank" rel="noreferrer">
      github.com/WarquahF
    </a>
    <button class="nav-kbd mono" type="button" data-command-trigger aria-label="Open command palette">
      <span>⌘</span>K
    </button>
    <button class="nav-theme" type="button" data-theme-toggle aria-label="Toggle color theme">
      <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const paintMeta = () => {
    meta?.setAttribute('content', root.dataset.theme === 'dark' ? '#0d0d10' : '#f5f5f2');
  };
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('wf-theme', next);
      } catch {
        /* private mode: theme just won't persist */
      }
      paintMeta();
    });
  });
  paintMeta();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem clamp(1.25rem, 5vw, 3.5rem);
    border-bottom: 1px solid transparent;
    background: transparent;
  }

  .nav-mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    transition: opacity 0.2s var(--ease-out);
  }

  .nav-mark:hover {
    opacity: 0.8;
  }

  .nav-mark-box {
    width: 1.4rem;
    height: 1.4rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--signal);
    font-size: 0.7rem;
  }

  .nav-mark-name {
    display: none;
  }

  @media (min-width: 560px) {
    .nav-mark-name {
      display: inline;
    }
  }

  .nav-links {
    display: none;
    gap: 1.25rem;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--signal);
    transition: width 0.25s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  @media (min-width: 780px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-github {
    display: none;
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .nav-github:hover {
    color: var(--ink);
  }

  @media (min-width: 960px) {
    .nav-github {
      display: inline;
    }
  }

  .nav-kbd {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-kbd:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav-theme {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-theme:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav-theme .icon-sun {
    display: none;
  }

  [data-theme='dark'] .nav-theme .icon-sun {
    display: block;
  }

  [data-theme='dark'] .nav-theme .icon-moon {
    display: none;
  }
</style>
