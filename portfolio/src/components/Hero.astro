---
import { social } from '../data/nav';
---

<section class="hero" data-reveal>
  <div class="hero-inner">
    <p class="hero-kicker mono" data-fade-late>Warquah Faiz — Student Developer</p>

    <h1 class="hero-title" data-entrance data-entrance-step="60">
      Software that respects your machine.
    </h1>

    <p class="hero-sub" data-fade-late>
      I build desktop software and developer tools — local-first, fast,
      and simple. Currently deep in the Blink Tauri migration.
    </p>

    <div class="hero-actions" data-fade-late>
      <a class="btn btn-primary mono" href="#work">View the work <span class="link-arrow">→</span></a>
      <a class="btn mono" href={social.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="btn mono" href="#contact">Contact</a>
    </div>

    <div class="hero-foot" data-fade-late>
      <p class="status-pill mono"><span class="pulse" aria-hidden="true"></span>Open to projects · Odisha, India</p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 96svh;
    display: flex;
    align-items: flex-end;
    padding: clamp(6rem, 12vw, 9rem) clamp(1.25rem, 5vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
    max-width: var(--wide-w);
  }

  .hero-inner {
    max-width: 60rem;
    width: 100%;
  }

  .hero-kicker {
    font-size: var(--step--2);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 10vw, 7.5rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.032em;
    max-width: 11ch;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 40ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: var(--ink-dim);
    margin-top: var(--space-xl);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: var(--space-2xl);
  }

  .btn {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink-dim);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.6rem 1.1rem;
    /* No transform transition: Motion owns button movement (magnetic pull). */
    transition:
      color 0.25s var(--cinematic, ease),
      border-color 0.25s var(--cinematic, ease),
      background-color 0.25s var(--cinematic, ease);
  }

  .btn:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .btn-primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .btn-primary:hover {
    color: var(--bg);
    border-color: #000;
    background: #000;
  }

  .hero-foot {
    margin-top: var(--space-2xl);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 0.95rem 0.45rem 0.75rem;
    margin: 0;
    background: color-mix(in srgb, var(--bg-raised) 60%, transparent);
  }

  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--go);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--go) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 9px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }

  /* Scroll cue removed — premium pages never say "scroll". */

  @media (max-width: 640px) {
    .hero {
      min-height: 86svh;
    }
    .hero-title {
      letter-spacing: -0.02em;
    }
  }
</style>
