---
import { social } from '../data/nav';
---

<section class="section" id="contact" data-reveal style="border-bottom: none;">
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/contact</span></p>
    <h2 data-text-reveal>Get in touch</h2>
    <p style="margin-top: 0.75rem;">
      Open to projects, collaborations and conversations about AI-powered
      software.
    </p>

    <div class="contact-links mono">
      <a href={social.github} target="_blank" rel="noreferrer">
        <span class="contact-label">GitHub</span>
        <span class="contact-value">github.com/WarquahF</span>
      </a>
      <a href={`mailto:${social.email}`}>
        <span class="contact-label">Email</span>
        <span class="contact-value">{social.email}</span>
      </a>
      <a href={social.x} target="_blank" rel="noreferrer">
        <span class="contact-label">X</span>
        <span class="contact-value">@warquah35</span>
      </a>
    </div>

    <p class="contact-note mono">Prefer async? Email works best — I usually reply within 24 hours.</p>
  </div>
</section>

<style>
  .contact-links {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .contact-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 0.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding-left 0.2s var(--ease, ease), color 0.2s ease;
    color: var(--ink-dim);
  }

  .contact-links a:hover {
    padding-left: 0.75rem;
    color: var(--ink);
  }

  .contact-label {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .contact-value {
    font-size: var(--step--1);
  }

  .contact-links a:hover .contact-value {
    color: var(--signal);
  }

  .contact-note {
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
