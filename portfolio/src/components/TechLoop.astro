---
const tech = [
  'Odin',
  'Rust',
  'C++',
  'Python',
  'JavaScript',
  'TypeScript',
  'HTML',
  'CSS',
  'Shell',
];
---

<section class="loop" aria-label="Languages and technologies">
  <div class="loop-track">
    {[0, 1].map((copy) => (
      <div class="loop-copy" aria-hidden={copy === 1}>
        {tech.map((t) => (
          <span class="loop-item">{t}<span class="loop-dot">·</span></span>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .loop {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding: var(--space-xl) 0;
    background: var(--bg);
  }

  .loop-track {
    display: flex;
    width: max-content;
    animation: loop-scroll 46s linear infinite;
  }

  .loop:hover .loop-track {
    animation-play-state: paused;
  }

  .loop-copy {
    display: flex;
    flex-shrink: 0;
  }

  .loop-item {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-faint);
    white-space: nowrap;
    padding-right: 0.6em;
    transition: color 0.25s ease;
  }

  .loop-item:hover {
    color: var(--ink);
  }

  .loop-dot {
    color: var(--line-strong);
    padding-left: 0.6em;
    font-weight: 400;
  }

  @keyframes loop-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop {
      overflow-x: auto;
    }
    .loop-track {
      animation: none;
    }
  }
</style>
